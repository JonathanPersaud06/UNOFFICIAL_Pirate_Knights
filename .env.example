# Configuration Template - Fill these out on your host machine
--- DISCORD AUTH & CHANNELS ---
DISCORD_TOKEN="your_discord_bot_token"
PEASANT_CHANNEL_ID="id_of_general_user_chat"
KING_CHANNEL_ID="id_of_admin_approvals_chat"
ANNOUNCEMENTS_CHANNEL_ID="id_of_download_status_chat"
KING_USER_ID="your_personal_discord_user_id"

--- PALANTIR AIP INTEGRATION ---
PALANTIR_AIP_URL="https://your-domain.palantirfoundry.com/"
PALANTIR_AIP_TOKEN="your_service_account_bearer_token"
PALANTIR_AIP_AGENT_ID="ri.aip.main.agent.your-unique-uuid"

--- LOCAL STACK ADDR ---
SONARR_API_URL="http://127.0.0.1:8989/" # Or your NAS LAN IP
SONARR_API_KEY="your_sonarr_api_key"
